# API Keys for Translation
# Rename this file to .env and fill in your keys

# DeepSeek API Key (if selected in config.yaml)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Gemini API Key (if selected in config.yaml)
GEMINI_API_KEY=your_gemini_api_key_here

# Main fallback API Key
API_KEY=your_fallback_api_key_here
